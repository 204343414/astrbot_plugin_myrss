  },
  "comment_max_length": {
    "description": "锐评最大字数",
    "type": "int",
    "default": 80
  },
  "bot_qq": {
    "description": "Bot的QQ号（用于显示头像）",
    "type": "string",
    "default": ""
  },
  "bot_provider_name": {
    "description": "Bot使用的服务商名称（显示在锐评旁边）",
    "type": "string",
    "default": ""
  },
  "content_filter": {
    "description": "是否过滤不适合推送的内容（反动/暴力/涩情等）",
    "type": "bool",
    "default": true
  }
