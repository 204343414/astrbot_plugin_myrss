{
  "title_max_length": {
    "description": "标题最大长度",
    "type": "int",
    "default": 60
  },
  "description_max_length": {
    "description": "描述最大长度",
    "type": "int",
    "default": 200
  },
  "max_items_per_poll": {
    "description": "每次轮询最大条目数",
    "type": "int",
    "default": 5
  },
  "t2i": {
    "description": "是否使用文字转图片",
    "type": "bool",
    "default": false
  },
  "is_hide_url": {
    "description": "是否隐藏链接",
    "type": "bool",
    "default": false
  },
  "is_read_pic": {
    "description": "是否读取图片",
    "type": "bool",
    "default": true
  },
  "is_adjust_pic": {
    "description": "图片防和谐",
    "type": "bool",
    "default": false
  },
  "max_pic_item": {
    "description": "最大图片数(-1不限)",
    "type": "int",
    "default": 3
  },
  "compose": {
    "description": "QQ平台合并转发",
    "type": "bool",
    "default": true
  },
  "enable_comment": {
    "description": "是否开启AI锐评（推送时bot用人设评论动态内容）",
    "type": "bool",
    "default": true
  },
  "comment_provider_id": {
    "description": "锐评用的LLM提供商（留空则用默认）",
